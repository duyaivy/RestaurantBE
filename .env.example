# dev | prod | test
ENV=dev
# Django
SECRET_KEY="django-insecure-*$0b8ibx7uzk45cm+fxw7*jj(yzi2ye!l4+!dnyxa-u-nbuz=q"
# Database
DB_NAME=restaurant
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
# Cors & host
HOST=http://localhost:8000/
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:3000
CLIENT_URL=http://localhost:3000
# Logging
LOG_LEVEL=INFO
DJANGO_DB_LOG_LEVEL=WARNING
REDIS_URL=redis://localhost:6379/0
# Chatbot embedding service
# Provider options: local | gemini | jina
CHATBOT_EMBEDDING_PROVIDER=local
CHATBOT_EMBEDDING_MODEL=intfloat/multilingual-e5-small
CHATBOT_EMBEDDING_DEVICE=cpu
CHATBOT_EMBEDDING_BATCH_SIZE=32
CHATBOT_EMBEDDING_NORMALIZE=true
CHATBOT_EMBEDDING_DIMENSIONS=768
CHATBOT_EMBEDDING_TIMEOUT_SECONDS=30
CHATBOT_EMBEDDING_API_KEY=
CHATBOT_EMBEDDING_BASE_URL=
# Jina (alternative): get free API key at https://jina.ai (10M tokens free trial)
# CHATBOT_EMBEDDING_PROVIDER=jina
# CHATBOT_EMBEDDING_MODEL=jina-embeddings-v3
# CHATBOT_EMBEDDING_DIMENSIONS=1024
# JINA_API_KEY=your_jina_api_key_here
# Chatbot LLM service
# Provider options: gemini | groq
CHATBOT_LLM_PROVIDER=gemini
CHATBOT_LLM_MODEL=gemini-2.5-flash-lite
GEMINI_API_KEY=your_gemini_api_key_here
CHATBOT_LLM_TEMPERATURE=0.2
CHATBOT_LLM_MAX_TOKENS=800
CHATBOT_LLM_REASONING_ENABLED=false
# Groq (alternative): free at https://console.groq.com — fast inference, no credit card
# CHATBOT_LLM_PROVIDER=groq
# CHATBOT_LLM_MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY=gsk_xxxxxxxxxxxx
# OpenRouter (legacy)
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# CHATBOT_LLM_BASE_URL=https://openrouter.ai/api/v1
# Local Chroma vector DB (Option A)
# Leave CHATBOT_CHROMA_DIR empty to use default: restaurantBE/chatbot/rag/.chroma
CHATBOT_CHROMA_DIR=
CHATBOT_CHROMA_COLLECTION=restaurant_chatbot
