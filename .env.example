# ==============================================================================
# Environment Configuration
# ==============================================================================
# Options: dev | prod | test
ENV=dev
DJANGO_SETTINGS_MODULE=restaurantBE.settings.local

# Django Security
SECRET_KEY="django-insecure-*$0b8ibx7uzk45cm+fxw7*jj(yzi2ye!l4+!dnyxa-u-nbuz=q"

# Server & Network
PORT=8000
HOST=http://localhost:8000/
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CLIENT_URL=http://localhost:3000

# ==============================================================================
# Database Configuration
# ==============================================================================
# Option 1: Full URL (Ưu tiên dùng nếu có - hỗ trợ Neon, Supabase, hoặc Docker DB)
# - Khi test docker local với service db: postgresql://postgres:postgres@db:5432/restaurant
# - Khi test trực tiếp trên máy host không qua docker: postgresql://postgres:postgres@localhost:5432/restaurant
# DATABASE_URL=postgresql://postgres:postgres@db:5432/restaurant

# Option 2: Individual DB credentials (được sử dụng khi không có DATABASE_URL)
DB_NAME=restaurant
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# ==============================================================================
# Redis Cache & Message Broker (Socket.IO)
# ==============================================================================
# - Trong Docker Compose: redis://redis:6379/0
# - Trên máy host (ngoài Docker): redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0

# ==============================================================================
# Logging
# ==============================================================================
LOG_LEVEL=INFO
DJANGO_DB_LOG_LEVEL=WARNING
WEB_CONCURRENCY=2

# ==============================================================================
# Media Storage (Cloudinary)
# ==============================================================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==============================================================================
# Payment Gateway (VNPay Sandbox)
# ==============================================================================
VNPAY_TMN_CODE=your_tmn_code
VNPAY_HASH_SECRET=your_hash_secret
VNPAY_RETURN_URL=http://localhost:8000/api/orders/verify/
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_ORDER_TYPE=18000

# ==============================================================================
# Google Cloud Translation (Optional)
# ==============================================================================
GOOGLE_TRANSLATION_ENABLED=false
GOOGLE_TRANSLATION_PROJECT_ID=
GOOGLE_TRANSLATION_LOCATION=global
GOOGLE_CREDENTIALS_JSON_BASE64=

# ==============================================================================
# Chatbot AI & RAG
# ==============================================================================
# Chatbot Embedding Provider: local | gemini | jina
CHATBOT_EMBEDDING_PROVIDER=local
CHATBOT_EMBEDDING_MODEL=intfloat/multilingual-e5-small
CHATBOT_EMBEDDING_DEVICE=cpu
CHATBOT_EMBEDDING_BATCH_SIZE=32
CHATBOT_EMBEDDING_NORMALIZE=true
CHATBOT_EMBEDDING_DIMENSIONS=768
CHATBOT_EMBEDDING_TIMEOUT_SECONDS=30
CHATBOT_EMBEDDING_API_KEY=

# Chatbot LLM Provider: gemini | groq
CHATBOT_LLM_PROVIDER=groq
CHATBOT_LLM_MODEL=llama-3.1-8b-instant
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
CHATBOT_LLM_TEMPERATURE=0.2
CHATBOT_LLM_MAX_TOKENS=800
CHATBOT_LLM_REASONING_ENABLED=false

# Chroma Vector Database
CHATBOT_CHROMA_DIR=
CHATBOT_CHROMA_COLLECTION=restaurant_chatbot
