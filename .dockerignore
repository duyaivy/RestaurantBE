# Version control
.git/
.gitignore

# Python
*.pyc
*.pyo
__pycache__/
venv/
.venv/
env/
*.egg-info/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker (don't send Docker context to Docker context)
Dockerfile
docker-compose.yml
docker-compose*.yml

# Docs
docs/
README.md
LICENSE

# Dev/test files
*.test
*.spec
tests/
scripts/test_*.py
scratch_*

# Node
node_modules/

# Logs
logs/
*.log

# Build artifacts
dist/
build/
staticfiles/

# ChromaDB lives on a runtime disk, never inside the image
restaurantBE/chatbot/rag/.chroma/
**/.chroma/
*.sqlite3
*.db

# Local credentials and agent/editor history
sinuous-maker-*.json
*credentials*.json
*.pem
*.key
.history/
.agents/
.claude/
.codex/
.aws/
.github/

# Local settings (keep production.py)
restaurantBE/settings/local.py

# Env files (passed via env_file or environment)
.env
.env.*
!.env.example
